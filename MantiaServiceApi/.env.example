# Copia este archivo como .env para configurar la extracción con Gemini.
# Sin API key (o si la key falla/expira) la API sigue funcionando con el
# motor de reglas local como respaldo: nunca se rompe la funcionalidad.

# Obligatoria para usar Gemini. Obtén una gratis en https://aistudio.google.com/apikey
GEMINI__APIKEY=

# Opcional. Modelo a usar (por defecto: gemini-2.0-flash)
GEMINI__MODEL=gemini-2.0-flash

# Opcional. Segundos de espera antes de caer al motor de reglas (por defecto: 8)
GEMINI__TIMEOUTSECONDS=8
